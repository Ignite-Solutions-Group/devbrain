{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID}"
    },
    "entraClientSecretValue": {
      "value": "${ENTRA_CLIENT_SECRET=}"
    },
    "jwtSigningSecretValue": {
      "value": "${JWT_SIGNING_SECRET=}"
    },
    "oauthAccessTokenLifetimeMinutes": {
      "value": "${OAUTH_ACCESS_TOKEN_LIFETIME_MINUTES=}"
    },
    "oauthRefreshReplayLifetimeMinutes": {
      "value": "${OAUTH_REFRESH_REPLAY_LIFETIME_MINUTES=}"
    },
    "containerAppImage": {
      "value": "${SERVICE_SERVER_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    }
  }
}
