{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID}"
    },
    "entraClientSecretValue": {
      "value": "${ENTRA_CLIENT_SECRET=}"
    },
    "jwtSigningSecretValue": {
      "value": "${JWT_SIGNING_SECRET=}"
    },
    "oauthAccessTokenLifetimeMinutes": {
      "value": "${OAUTH_ACCESS_TOKEN_LIFETIME_MINUTES=}"
    },
    "oauthRefreshReplayLifetimeMinutes": {
      "value": "${OAUTH_REFRESH_REPLAY_LIFETIME_MINUTES=}"
    },
    "cosmosServerless": {
      "value": "${COSMOS_SERVERLESS=false}"
    },
    "frontDoorSkuName": {
      "value": "${FRONT_DOOR_SKU=Standard_AzureFrontDoor}"
    },
    "customDomainName": {
      "value": "${CUSTOM_DOMAIN_NAME=}"
    },
    "frontDoorProfileName": {
      "value": "${FRONT_DOOR_PROFILE_NAME=}"
    },
    "frontDoorResourceGroupName": {
      "value": "${FRONT_DOOR_RESOURCE_GROUP=}"
    },
    "frontDoorSubscriptionId": {
      "value": "${FRONT_DOOR_SUBSCRIPTION_ID=}"
    },
    "dnsZoneName": {
      "value": "${DNS_ZONE_NAME=}"
    },
    "dnsZoneResourceGroupName": {
      "value": "${DNS_ZONE_RESOURCE_GROUP=}"
    },
    "dnsZoneSubscriptionId": {
      "value": "${DNS_ZONE_SUBSCRIPTION_ID=}"
    },
    "frontDoorAllowedCountryCodes": {
      "value": "${FRONT_DOOR_ALLOWED_COUNTRIES=}"
    },
    "containerAppImage": {
      "value": "${SERVICE_SERVER_IMAGE_NAME=mcr.microsoft.com/dotnet/samples:aspnetapp}"
    }
  }
}
